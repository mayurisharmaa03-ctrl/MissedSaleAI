# MissedSale AI Environment Variables Example

# Secret key for session encryption
SECRET_KEY=missedsale-ai-super-secret-key-2026

# PostgreSQL Database URL
# Example for local PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/missedsale_ai
# Note: If PostgreSQL is unreachable, the system automatically falls back to SQLite (missedsale.db)

# Resend API Key for real email delivery (get your API key at https://resend.com)
RESEND_API_KEY=
# Verified sender email address configured in your Resend account (e.g., onboarding@resend.dev or notifications@yourdomain.com)
EMAIL_FROM=

# Autonomous Agent Decision Thresholds
LOST_SALE_THRESHOLD=0.60
RECOVERY_THRESHOLD_HIGH=0.70
RECOVERY_THRESHOLD_MED=0.40
MAX_OUTREACH_ATTEMPTS=2

# Flask Debug Mode
FLASK_DEBUG=True
