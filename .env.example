# MissedSale AI Environment Variables Template
# Copy this file to .env and configure your values.
# Never commit a real .env file.

SECRET_KEY=your-secret-key
DATABASE_URL=your-postgresql-url
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=your-verified-email

# Autonomous Agent Decision Thresholds
LOST_SALE_THRESHOLD=0.60
RECOVERY_THRESHOLD_HIGH=0.70
RECOVERY_THRESHOLD_MED=0.40
MAX_OUTREACH_ATTEMPTS=2

# Flask Debug Mode
FLASK_DEBUG=True
